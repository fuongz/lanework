{
  "name": "lanework",
  "private": true,
  "type": "module",
  "packageManager": "bun@1.3.11",
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "scripts": {
    "dev": "bun run --cwd apps/desktop dev",
    "dev:api": "bun run --cwd apps/api dev",
    "dev:mcp": "bun run --cwd apps/mcp dev",
    "dev:landing": "bun run --cwd apps/landing dev",
    "build": "bun run --cwd apps/desktop build",
    "build:api": "bun run --cwd apps/api build",
    "build:mcp": "bun run --cwd apps/mcp build",
    "build:landing": "bun run --cwd apps/landing build",
    "deploy:api": "bun run --cwd apps/api deploy",
    "deploy:mcp": "bun run --cwd apps/mcp deploy",
    "deploy:landing": "bun run --cwd apps/landing deploy",
    "test:api": "bun run --cwd apps/api test",
    "typecheck": "bun run --cwd packages/db typecheck && bun run --cwd apps/api typecheck && bun run --cwd apps/mcp typecheck && bun run --cwd apps/desktop typecheck && bun run --cwd apps/landing typecheck",
    "lint": "biome check . && node scripts/audit-layout.mjs",
    "format": "biome check --write .",
    "gate": "bun run build && bun run build:api && bun run build:mcp && bun run build:landing && bun run lint && bun run typecheck",
    "package": "bun run --cwd apps/desktop package",
    "test": "bun run --cwd apps/desktop test",
    "test:dev": "bun run --cwd apps/desktop test:dev",
    "test:packaged": "bun run --cwd apps/desktop test:packaged",
    "gallery": "bun run --cwd apps/desktop gallery",
    "gallery:index": "bun run --cwd apps/desktop gallery:index"
  },
  "devDependencies": {
    "@biomejs/biome": "^2.5.12",
    "typescript": "^7.0.2"
  },
  "trustedDependencies": [
    "electron",
    "esbuild"
  ],
  "dependencies": {
    "wrangler": "^4.137.0"
  }
}
