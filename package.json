{
  "name": "lanework",
  "private": true,
  "type": "module",
  "packageManager": "bun@1.3.11",
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "scripts": {
    "dev": "bun run --cwd apps/desktop dev",
    "build": "bun run --cwd apps/desktop build",
    "build:plugin": "node scripts/build-plugin.mjs",
    "typecheck": "bun run --cwd packages/protocol typecheck && bun run --cwd apps/desktop typecheck",
    "lint": "biome check --error-on-warnings . && node scripts/audit-layout.mjs && node scripts/audit-loading.mjs && node scripts/audit-sinks.mjs",
    "format": "biome check --write .",
    "gate": "bun run gate:public",
    "gate:public": "bun run build && bun run lint && bun run typecheck && node scripts/build-plugin.mjs --check",
    "package": "bun run --cwd apps/desktop package",
    "test": "bun run --cwd apps/desktop test",
    "test:unit": "bun run --cwd apps/desktop test:unit",
    "test:dev": "bun run --cwd apps/desktop test:dev",
    "test:packaged": "bun run --cwd apps/desktop test:packaged",
    "gallery": "bun run --cwd apps/desktop gallery",
    "gallery:index": "bun run --cwd apps/desktop gallery:index"
  },
  "devDependencies": {
    "@biomejs/biome": "^2.5.12",
    "typescript": "^7.0.2"
  },
  "trustedDependencies": [
    "electron",
    "esbuild"
  ]
}
