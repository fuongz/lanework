{
  "$schema": "https://biomejs.dev/schemas/2.5.12/schema.json",
  "vcs": {
    "enabled": true,
    "clientKind": "git",
    "useIgnoreFile": true
  },
  "files": {
    "includes": [
      "**",
      "!!.agents",
      "!!apps/desktop/src/routeTree.gen.ts",
      "!!apps/landing/src/routeTree.gen.ts",
      "!!scripts/audit-layout.mjs",
      // INF-03: the plugin's hook, BUILT from apps/desktop/electron/hook/ and
      // committed because a plugin installs by clone. `build-plugin.mjs
      // --check` guards it; the formatter must not touch it.
      "!!plugins/lanework/bin/lanework-checkpoint.cjs",
      "!!apps/landing/worker-configuration.d.ts"
    ]
  },
  "formatter": {
    "indentStyle": "space"
  },
  "javascript": {
    "formatter": {
      "quoteStyle": "double"
    }
  },
  "css": {
    "parser": {
      "tailwindDirectives": true
    }
  },
  "linter": {
    "enabled": true,
    "rules": {
      "preset": "recommended"
    }
  },
  "overrides": [
    {
      "includes": ["apps/desktop/src/components/ui/field.tsx"],
      "linter": {
        "rules": {
          "a11y": {
            "useSemanticElements": "off"
          },
          "suspicious": {
            "noDoubleEquals": "off",
            "noArrayIndexKey": "off"
          }
        }
      }
    },
    {
      // Vendored by the shadcn CLI. Its addons are `role`-bearing divs and one
      // click target that a real element cannot express here; the file is
      // regenerated by the registry, so a local fix would be reverted by the
      // next `shadcn add`.
      "includes": ["apps/desktop/src/components/ui/input-group.tsx"],
      "linter": {
        "rules": {
          "a11y": {
            "useSemanticElements": "off",
            "useKeyWithClickEvents": "off"
          }
        }
      }
    },
    {
      "includes": ["apps/desktop/src/components/ui/label.tsx"],
      "linter": {
        "rules": {
          "a11y": {
            "noLabelWithoutControl": "off"
          }
        }
      }
    }
  ]
}
