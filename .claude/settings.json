{
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "Bash",
        "hooks": [
          {
            "type": "command",
            "command": "\"$CLAUDE_PROJECT_DIR/.claude/hooks/no-full-suite.sh\"",
            "timeout": 10
          }
        ]
      }
    ],
    "Stop": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "command -v bun >/dev/null && bun \"$CLAUDE_PROJECT_DIR/.claude/hooks/lanework-checkpoint.ts\" || true",
            "timeout": 10
          }
        ]
      }
    ]
  }
}
