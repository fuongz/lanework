{
  "name": "@lanework/desktop",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "imports": {
    "#/*": "./src/*"
  },
  "scripts": {
    "dev": "node scripts/dev.mjs",
    "dev:renderer": "vite dev",
    "build": "node scripts/build.mjs",
    "typecheck": "tsc --noEmit -p tsconfig.json && tsc --noEmit -p tsconfig.node.json",
    "package": "bun run build && electron-builder --dir --config electron-builder.package.yml",
    "dist": "bun run build && electron-builder",
    "test": "playwright test --project=production",
    "test:unit": "bun test ./electron",
    "test:dev": "playwright test --project=development",
    "test:packaged": "playwright test --project=packaged",
    "gallery": "playwright test --project=gallery",
    "gallery:index": "GALLERY_INDEX_ONLY=1 playwright test --project=gallery"
  },
  "devDependencies": {
    "@base-ui/react": "^1.8.0",
    "@codemirror/commands": "^6.11.0",
    "@codemirror/lang-json": "^6.0.2",
    "@codemirror/lang-markdown": "^6.5.2",
    "@codemirror/language": "^6.12.4",
    "@codemirror/legacy-modes": "^6.5.5",
    "@codemirror/state": "^6.7.4",
    "@codemirror/view": "^6.43.11",
    "@dnd-kit/core": "^6.3.1",
    "@fontsource-variable/inter": "^5.3.0",
    "@hugeicons/core-free-icons": "^4.3.0",
    "@hugeicons/react": "^1.1.10",
    "@lanework/protocol": "workspace:*",
    "@lezer/highlight": "^1.2.3",
    "@lydell/node-pty": "1.2.0-beta.15",
    "@pierre/diffs": "^1.4.2",
    "@pierre/trees": "1.0.0-beta.6",
    "@playwright/test": "^1.63.0",
    "@tailwindcss/vite": "^4.3.3",
    "@tanstack/react-router": "^1.170.33",
    "@tanstack/react-start": "^1.168.50",
    "@types/node": "^26.4.1",
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.7",
    "@vitejs/plugin-react": "^6.1.1",
    "@xterm/addon-fit": "^0.11.0",
    "@xterm/addon-serialize": "^0.14.0",
    "@xterm/headless": "^6.0.0",
    "@xterm/xterm": "^6.0.0",
    "class-variance-authority": "^0.7.1",
    "cmdk": "^1.1.1",
    "cn": "^0.2.6",
    "electron": "^44.9.3",
    "electron-builder": "^26.15.3",
    "esbuild": "^0.28.2",
    "motion": "^13.2.0",
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "react-resizable-panels": "^4.13.1",
    "shadcn": "^4.21.0",
    "smol-toml": "^1.9.0",
    "tailwindcss": "^4.3.3",
    "tw-animate-css": "^1.4.0",
    "vite": "^8.2.2",
    "zustand": "^5.0.15"
  },
  "main": "dist/electron/main/index.cjs",
  "description": "Lanework desktop workspace",
  "author": "Lanework",
  "license": "MIT"
}
